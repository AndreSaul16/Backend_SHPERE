server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Location relativa en los 301: tras el proxy de Railway, la absoluta sale con http y el puerto interno.
    absolute_redirect off;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;
    gzip_min_length 256;

    # Enable sub_filter for JavaScript and HTML content types (runtime VITE_API_URL substitution).
    # Must be in server context so it applies to ALL locations, including regex-matched JS/CSS assets.
    sub_filter_types application/javascript text/html;
    sub_filter '__VITE_API_URL__' '${VITE_API_URL}';
    sub_filter_once off;

    # Security headers
    #
    # OJO al tocar esto: `add_header` NO se hereda en un `location` que declare
    # su propio `add_header`. nginx REEMPLAZA el juego entero, no lo fusiona.
    # Por eso las cuatro están REPETIDAS más abajo en cada location que declara
    # alguna cabecera. Si se añade una aquí y no allí, el documento se servirá
    # sin ella y nadie se enterará.
    #
    # Lo vigila frontend/tests/lib/cabecerasDeSeguridad.test.ts, que además
    # comprueba que este fichero y nginx.conf no se separen.
    #
    # COOP `same-origin-allow-popups` y no `same-origin`: la página ABRE popups
    # de acceso (Google, GitHub, Microsoft) y necesita conservar la relación
    # `opener` con ellos. Con `same-origin` el SDK de Firebase lee
    # `window.closed` antes de tiempo y rechaza con `auth/popup-closed-by-user`
    # aunque el acceso vaya bien. Tampoco `unsafe-none`, que es no aislarse.
    #
    # Sólo texto literal: `envsubst` corre sobre esta plantilla en el arranque.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;

    # ═══ La raíz del dominio ES la landing de marketing ══════════════════════
    #
    # `frontend/landing` se construye en esta misma imagen y su `dist` se copia
    # a html/landing. Aquí se decide qué URL le toca a cada cosa:
    #
    #   /               → el documento de la landing (este bloque)
    #   /landing/...    → sus assets con hash, por el bloque de estáticos
    #   todo lo demás   → la SPA del producto, exactamente igual que antes
    #
    # `= /` es coincidencia EXACTA: sólo la raíz pelada. /login, /register,
    # /chat/... siguen cayendo en el bloque general de abajo.
    #
    # `try_files` con un fichero que EXISTE lo sirve en ESTE bloque, sin
    # redirección interna — al revés que el bloque `= /index.html` de abajo, al
    # que el SPA llega rebotado. Por eso las cabeceras que salen de aquí son
    # las de aquí, y por eso están repetidas las cuatro.
    #
    # `$uri` no aparece aquí, pero sí abajo: el envsubst del arranque está
    # acotado a PORT, VITE_API_URL y BACKEND_PRIVATE_URL (docker-entrypoint.sh),
    # así que las variables de nginx sobreviven.
    location = / {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        # Repetidas: este `add_header` anula las del server (ver arriba).
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
        try_files /landing/index.html =404;
    }

    # /landing, /landing/ y /landing/index.html → la raíz.
    #
    # El documento vive en UNA sola URL: el canonical de la página apunta a la
    # raíz, y servir lo mismo en dos sitios es contenido duplicado. Los assets
    # SÍ cuelgan de /landing/ y no casan con este patrón, que exige final de
    # cadena.
    location ~ ^/landing/?(index\.html)?$ {
        return 301 /;
    }

    # SPA fallback — all routes serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets (JS, CSS, images) for 1 year
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        # Repetidas: este `add_header` anula las del server (ver arriba).
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
    }

    # No cache for index.html (always fresh)
    location = /index.html {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        # Repetidas: este `add_header` anula las del server (ver arriba). Y este
        # es EL bloque que importa: el `try_files` de arriba hace redirección
        # interna a /index.html, así que cualquier ruta del SPA sirve su
        # documento por aquí. Sin estas cuatro líneas, la aplicación entera se
        # servía sin ninguna cabecera de seguridad.
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
    }

    # Backend API proxy — reenvía /api/v1/ al backend Railway service
    location /api/v1/ {
        # BACKEND_PRIVATE_URL se sustituye con el valor real en el build de Railway
        proxy_pass ${BACKEND_PRIVATE_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }
}
