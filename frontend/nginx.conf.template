server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;
    gzip_min_length 256;

    # Enable sub_filter for JavaScript and HTML content types (runtime VITE_API_URL substitution).
    # Must be in server context so it applies to ALL locations, including regex-matched JS/CSS assets.
    sub_filter_types application/javascript text/html;
    sub_filter '__VITE_API_URL__' '${VITE_API_URL}';
    sub_filter_once off;

    # Security headers
    #
    # OJO al tocar esto: `add_header` NO se hereda en un `location` que declare
    # su propio `add_header`. nginx REEMPLAZA el juego entero, no lo fusiona.
    # Por eso las cuatro están REPETIDAS más abajo en cada location que declara
    # alguna cabecera. Si se añade una aquí y no allí, el documento se servirá
    # sin ella y nadie se enterará.
    #
    # Lo vigila frontend/tests/lib/cabecerasDeSeguridad.test.ts, que además
    # comprueba que este fichero y nginx.conf no se separen.
    #
    # COOP `same-origin-allow-popups` y no `same-origin`: la página ABRE popups
    # de acceso (Google, GitHub, Microsoft) y necesita conservar la relación
    # `opener` con ellos. Con `same-origin` el SDK de Firebase lee
    # `window.closed` antes de tiempo y rechaza con `auth/popup-closed-by-user`
    # aunque el acceso vaya bien. Tampoco `unsafe-none`, que es no aislarse.
    #
    # Sólo texto literal: `envsubst` corre sobre esta plantilla en el arranque.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;

    # SPA fallback — all routes serve index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets (JS, CSS, images) for 1 year
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        # Repetidas: este `add_header` anula las del server (ver arriba).
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
    }

    # No cache for index.html (always fresh)
    location = /index.html {
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        # Repetidas: este `add_header` anula las del server (ver arriba). Y este
        # es EL bloque que importa: el `try_files` de arriba hace redirección
        # interna a /index.html, así que cualquier ruta del SPA sirve su
        # documento por aquí. Sin estas cuatro líneas, la aplicación entera se
        # servía sin ninguna cabecera de seguridad.
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cross-Origin-Opener-Policy "same-origin-allow-popups" always;
    }

    # Backend API proxy — reenvía /api/v1/ al backend Railway service
    location /api/v1/ {
        # BACKEND_PRIVATE_URL se sustituye con el valor real en el build de Railway
        proxy_pass ${BACKEND_PRIVATE_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }
}
