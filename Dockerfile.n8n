# Imagen del servicio n8n para Railway.
# Sin volumen persistente, cada deploy pierde los workflows importados y las
# credenciales configuradas en n8n (el backend los re-importa en arranque, pero
# las ejecuciones y ajustes manuales se perderían).
FROM n8nio/n8n:latest

# Persistencia de workflows, credenciales y ejecuciones.
VOLUME /home/node/.n8n

# n8n expone /healthz en el puerto 5678. start-period generoso para no matar
# el contenedor durante el arranque (lección del incidente 5ec712f del frontend).
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 CMD wget -q --spider http://localhost:5678/healthz || exit 1
